#version 430 core
//
// pass: passive skin DQS + collider push (compute)
//
// One invocation per mesh vertex:
//   1. Reads ``bind_positions[vid]`` (the rest-pose vertex in mesh-local space)
//   2. Does 4-bone dual-quaternion skinning against ``bone_dual_quats`` to get
//      the animated world position (with screw-motion blending, no LBS
//      candy-wrap at twisted joints)
//   3. Iterates colliders, projecting the world position outside any sphere
//      or capsule it landed inside — skipping colliders whose excluded-joint
//      bitmask covers this vertex's dominant joint
//   4. Transforms the result by ``u_worldToLocal`` and writes it as a packed
//      float[3] into ``out_positions`` — i.e. directly into the mesh's
//      position VBO, no CPU readback needed.
//
// Previously this compute pass did LBS even though the toon/outline/shadow
// vertex shaders use DQS. For passive_skin_deform pieces (like the main
// body mesh registered via collision_deform_meshes) the GPU compute path
// owns the final positions, so the visible skin used LBS regardless of
// what the renderer's DQS shaders did downstream. Switching this shader
// to DQS makes the GPU passive-skin path match the GPU vertex-shader path
// — joint volume is preserved at the shoulder / waist / knee.
//
// Bindings:
//   SSBO 0: BindPositions   (read)   — packed float[3] per vert
//   SSBO 1: Joints          (read)   — 4 uints per vert
//   SSBO 2: Weights         (read)   — 4 floats per vert
//   SSBO 3: BoneDualQuats   (read)   — 2 vec4 per joint (qr, qd)
//   SSBO 4: OutputPositions (write)
//   SSBO 5: DominantJoint   (read)
//   SSBO 6: ColliderExclude (read)
//   SSBO 7: BindNormals     (read)
//   SSBO 8: OutputNormals   (write)
//
//   UBO 0: CollidersUBO

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer BindPositions {
    float bind_positions[];
};
layout(std430, binding = 1) readonly buffer Joints {
    uint joints[];
};
layout(std430, binding = 2) readonly buffer Weights {
    float weights[];
};
layout(std430, binding = 3) readonly buffer BoneDualQuats {
    // 2 * vec4 per joint: index j has real at 2*j and dual at 2*j+1.
    vec4 bone_dual_quats[];
};
layout(std430, binding = 4) writeonly buffer OutputPositions {
    float out_positions[];
};
layout(std430, binding = 5) readonly buffer DominantJoint {
    int dominant_joint[];
};
layout(std430, binding = 6) readonly buffer ColliderExclude {
    uint collider_exclude_bits[];
};
layout(std430, binding = 7) readonly buffer BindNormals {
    float bind_normals[];
};
layout(std430, binding = 8) writeonly buffer OutputNormals {
    float out_normals[];
};

#define MAX_COLLIDERS 32
#define BONE_WORDS 16

struct GpuCollider {
    vec4 data1;
    vec4 data2;
    vec4 extras;
};

layout(std140, binding = 0) uniform CollidersUBO {
    uint u_colliderCount;
    uint _pad0;
    uint _pad1;
    uint _pad2;
    GpuCollider u_colliders[MAX_COLLIDERS];
};

uniform uint u_vertCount;
uniform mat4 u_worldToLocal;
// Ground-clamp gate. See passive_skin_push.comp prior version for full
// rationale. Tolerance > 0 lets verts dip up to that far below the floor
// before being clamped, so the mesh keeps natural skinning curvature.
uniform uint u_groundEnabled;
uniform float u_groundY;
uniform float u_groundTolerance;


vec3 _rotate_by_quat(vec3 v, vec4 q) {
    return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}


void main() {
    uint vid = gl_GlobalInvocationID.x;
    if (vid >= u_vertCount) {
        return;
    }

    vec3 p_bind = vec3(
        bind_positions[vid * 3u + 0u],
        bind_positions[vid * 3u + 1u],
        bind_positions[vid * 3u + 2u]
    );

    // 4-bone DQS blend. Mirrors toon_skinned_dqs.vert per-vert math.
    uint j0 = joints[vid * 4u + 0u];
    uint j1 = joints[vid * 4u + 1u];
    uint j2 = joints[vid * 4u + 2u];
    uint j3 = joints[vid * 4u + 3u];
    float w0 = weights[vid * 4u + 0u];
    float w1 = weights[vid * 4u + 1u];
    float w2 = weights[vid * 4u + 2u];
    float w3 = weights[vid * 4u + 3u];

    vec4 q0r = bone_dual_quats[j0 * 2u + 0u];
    vec4 q0d = bone_dual_quats[j0 * 2u + 1u];
    vec4 q1r = bone_dual_quats[j1 * 2u + 0u];
    vec4 q1d = bone_dual_quats[j1 * 2u + 1u];
    vec4 q2r = bone_dual_quats[j2 * 2u + 0u];
    vec4 q2d = bone_dual_quats[j2 * 2u + 1u];
    vec4 q3r = bone_dual_quats[j3 * 2u + 0u];
    vec4 q3d = bone_dual_quats[j3 * 2u + 1u];

    // Antipodal correction so weighted blend doesn't cancel at twisted joints.
    if (dot(q0r, q1r) < 0.0) { q1r = -q1r; q1d = -q1d; }
    if (dot(q0r, q2r) < 0.0) { q2r = -q2r; q2d = -q2d; }
    if (dot(q0r, q3r) < 0.0) { q3r = -q3r; q3d = -q3d; }

    vec4 blend_r = w0 * q0r + w1 * q1r + w2 * q2r + w3 * q3r;
    vec4 blend_d = w0 * q0d + w1 * q1d + w2 * q2d + w3 * q3d;

    float norm = max(length(blend_r), 1.0e-6);
    blend_r /= norm;
    blend_d /= norm;

    vec3 rotated_p = _rotate_by_quat(p_bind, blend_r);
    vec3 t = 2.0 * (
        blend_r.w * blend_d.xyz - blend_d.w * blend_r.xyz
        + cross(blend_r.xyz, blend_d.xyz)
    );
    vec3 world_p = rotated_p + t;

    vec3 n_bind = vec3(
        bind_normals[vid * 3u + 0u],
        bind_normals[vid * 3u + 1u],
        bind_normals[vid * 3u + 2u]
    );
    vec3 n_world = _rotate_by_quat(n_bind, blend_r);

    // Collision push.
    int my_dominant = dominant_joint[vid];
    int dom_word = my_dominant >> 5;
    uint dom_bit = 1u << uint(my_dominant & 31);

    for (uint c = 0u; c < u_colliderCount; ++c) {
        uint excl = collider_exclude_bits[c * uint(BONE_WORDS) + uint(dom_word)];
        if ((excl & dom_bit) != 0u) {
            continue;
        }
        GpuCollider cl = u_colliders[c];
        float r = cl.data1.w + cl.extras.x;
        if (cl.data2.w < 0.5) {
            // Sphere
            vec3 center = cl.data1.xyz;
            vec3 delta = world_p - center;
            float dist_sq = dot(delta, delta);
            if (dist_sq < r * r) {
                float d = sqrt(max(dist_sq, 1.0e-12));
                vec3 norm = delta / d;
                world_p = center + norm * r;
            }
        } else {
            // Capsule
            vec3 a = cl.data1.xyz;
            vec3 b = cl.data2.xyz;
            vec3 ab = b - a;
            float ab_len_sq = dot(ab, ab);
            if (ab_len_sq > 1.0e-12) {
                float tc = clamp(dot(world_p - a, ab) / ab_len_sq, 0.0, 1.0);
                vec3 closest = a + tc * ab;
                vec3 delta = world_p - closest;
                float dist_sq = dot(delta, delta);
                if (dist_sq < r * r) {
                    float d = sqrt(max(dist_sq, 1.0e-12));
                    vec3 norm = delta / d;
                    world_p = closest + norm * r;
                }
            }
        }
    }

    // Soft floor clamp.
    if (u_groundEnabled != 0u) {
        float soft_floor = u_groundY + 1.0e-3 - u_groundTolerance;
        if (world_p.y < soft_floor) {
            world_p.y = soft_floor;
        }
    }

    // World → mesh-local for the renderer's model-matrix uniform.
    vec4 local_p = u_worldToLocal * vec4(world_p, 1.0);
    out_positions[vid * 3u + 0u] = local_p.x;
    out_positions[vid * 3u + 1u] = local_p.y;
    out_positions[vid * 3u + 2u] = local_p.z;

    vec3 n_local = mat3(u_worldToLocal) * n_world;
    out_normals[vid * 3u + 0u] = n_local.x;
    out_normals[vid * 3u + 1u] = n_local.y;
    out_normals[vid * 3u + 2u] = n_local.z;
}
