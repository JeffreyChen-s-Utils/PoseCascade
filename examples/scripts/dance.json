{
  "schema_version": 1,
  "name": "mmd_dance_declarative_demo",
  "loop_sec": 24.0,
  "bpm": 90,

  "hide": ["Stairs"],

  "rig": {
    "character_root": "Sketchfab_model",
    "leg_chain_l": ["J_Bip_L_UpperLeg", "J_Bip_L_LowerLeg", "J_Bip_L_Foot"],
    "leg_chain_r": ["J_Bip_R_UpperLeg", "J_Bip_R_LowerLeg", "J_Bip_R_Foot"],
    "knee_limit_min": [-2.4, 0, 0],
    "knee_limit_max": [0.1, 0, 0],
    "body_bones": {
      "hip":         "J_Bip_C_Hips",
      "chest":       "J_Bip_C_UpperChest",
      "head":        "J_Bip_C_Head",
      "upper_arm_L": "J_Bip_L_UpperArm",
      "upper_arm_R": "J_Bip_R_UpperArm",
      "lower_arm_L": "J_Bip_L_LowerArm",
      "lower_arm_R": "J_Bip_R_LowerArm",
      "upper_leg_L": "J_Bip_L_UpperLeg",
      "upper_leg_R": "J_Bip_R_UpperLeg",
      "lower_leg_L": "J_Bip_L_LowerLeg",
      "lower_leg_R": "J_Bip_R_LowerLeg",
      "foot_L":      "J_Bip_L_Foot",
      "foot_R":      "J_Bip_R_Foot"
    }
  },

  "ground": {
    "kind": "flat",
    "y": 0.0
  },

  "physics_chains": {
    "hair_C":  {"stiffness": 14.0, "damping": 0.45, "inertia": 0.015},
    "hair_L":  {"stiffness": 12.0, "damping": 0.40, "inertia": 0.015},
    "hair_R":  {"stiffness": 12.0, "damping": 0.40, "inertia": 0.015},
    "hair_LL": {"stiffness":  8.5, "damping": 0.30, "inertia": 0.020},
    "hair_RR": {"stiffness":  8.5, "damping": 0.30, "inertia": 0.020},
    "orn":     {"stiffness": 22.0, "damping": 0.80, "inertia": 0.020}
  },

  "wind": {
    "direction": [1.0, 0.0, 0.3],
    "speed": 0.15,
    "turbulence_amplitude": 0.05,
    "turbulence_frequency_hz": 1.2
  },

  "cloth": [
    {
      "mesh_node": "Object_146",
      "structural_stiffness": 0.90,
      "bend_stiffness": 0.18,
      "anchor_axis": 1,
      "anchor_fraction": 0.32,
      "anchor_mode": "top_axis",
      "rest_pull": 8.0,
      "iterations": 10
    }
  ],

  "colliders": [
    {"kind": "sphere", "follow_bone": "J_Bip_C_Hips",       "radius": 0.10},
    {"kind": "sphere", "follow_bone": "J_Bip_L_Hand",       "radius": 0.06},
    {"kind": "sphere", "follow_bone": "J_Bip_R_Hand",       "radius": 0.06},
    {
      "kind": "capsule",
      "follow_bone": "J_Bip_L_UpperLeg",
      "end_bone":    "J_Bip_L_LowerLeg",
      "radius":      0.07
    },
    {
      "kind": "capsule",
      "follow_bone": "J_Bip_R_UpperLeg",
      "end_bone":    "J_Bip_R_LowerLeg",
      "radius":      0.07
    },
    {
      "kind": "capsule",
      "follow_bone": "J_Bip_L_LowerArm",
      "end_bone":    "J_Bip_L_Hand",
      "radius":      0.045
    },
    {
      "kind": "capsule",
      "follow_bone": "J_Bip_R_LowerArm",
      "end_bone":    "J_Bip_R_Hand",
      "radius":      0.045
    }
  ],

  "phases": [
    {
      "name": "sway_in_place",
      "duration_beats": 6,
      "blend_in_sec": 0.5,
      "blend_out_sec": 0.5,
      "body": {
        "yaw_rad": "0.05 * sin(phase_beat * tau / 6)",
        "lean_x_rad": "0.05 * sin(phase_beat * tau / 6)",
        "translation": {
          "x": "0.005 * sin(phase_beat * tau / 6)",
          "y": 0.0,
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 1.5,
        "leg_swing_amplitude": 0.10,
        "knee_bend": -0.18,
        "arm_swing_amplitude": 0.20,
        "arm_hang_rad": -1.45
      },
      "bones": {
        "head": {
          "y_rad": "0.20 * sin(phase_beat * tau / 6)",
          "x_rad": "0.04 * sin(phase_beat * tau / 3)"
        },
        "chest": {"x_rad": "0.04 * sin(phase_beat * tau / 6)"},
        "hip": {"y_rad": "0.08 * sin(phase_beat * tau / 6)"}
      },
      "morphs": {
        "blink": "0.5 + 0.5 * sin(elapsed * tau / 4.0)",
        "smile": {"kind": "ease", "from": 0.3, "to": 0.6}
      }
    },

    {
      "name": "soft_reach_R",
      "duration_beats": 6,
      "blend_in_sec": 1.2,
      "blend_out_sec": 1.0,
      "pose": "reach_R_soft",
      "body": {
        "yaw_rad": -0.10,
        "lean_x_rad": -0.06,
        "translation": {
          "x": -0.005,
          "y": 0.0,
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 1.5,
        "leg_swing_amplitude": 0.06,
        "knee_bend": -0.18,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.45
      },
      "morphs": {
        "smile": 0.65
      }
    },

    {
      "name": "soft_reach_L",
      "duration_beats": 6,
      "blend_in_sec": 1.2,
      "blend_out_sec": 1.0,
      "pose": "reach_L_soft",
      "body": {
        "yaw_rad": 0.10,
        "lean_x_rad": 0.06,
        "translation": {
          "x": 0.005,
          "y": 0.0,
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 1.5,
        "leg_swing_amplitude": 0.06,
        "knee_bend": -0.18,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.45
      },
      "morphs": {
        "smile": 0.65
      }
    },

    {
      "name": "groove_step",
      "duration_beats": 6,
      "blend_in_sec": 0.5,
      "blend_out_sec": 0.5,
      "body": {
        "yaw_rad": "0.06 * sin(phase_beat * tau / 4)",
        "lean_x_rad": "0.06 * sin(phase_beat * tau / 4)",
        "translation": {
          "x": "0.005 * sin(phase_beat * tau / 4)",
          "y": 0.0,
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 1.0,
        "leg_swing_amplitude": 0.12,
        "knee_bend": -0.22,
        "arm_swing_amplitude": 0.30,
        "arm_hang_rad": -1.40
      },
      "bones": {
        "hip": {"y_rad": "0.14 * sin(phase_beat * tau / 4)"},
        "chest": {
          "y_rad": "-0.08 * sin(phase_beat * tau / 4)",
          "x_rad": 0.04
        },
        "head": {"y_rad": "0.12 * sin(phase_beat * tau / 4)"}
      },
      "morphs": {
        "smile": 0.75,
        "blink": "0.5 + 0.5 * sin(elapsed * tau / 3.0)"
      }
    },

    {
      "name": "open_arms_lean_back",
      "duration_beats": 6,
      "blend_in_sec": 1.2,
      "blend_out_sec": 1.0,
      "pose": "arms_open",
      "body": {
        "yaw_rad": 0.0,
        "lean_x_rad": {"kind": "cubic-out", "from": 0.0, "to": -0.10},
        "translation": {
          "x": 0.0,
          "y": 0.0,
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 1.5,
        "leg_swing_amplitude": 0.05,
        "knee_bend": -0.18,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.45
      },
      "morphs": {
        "smile": {"kind": "ease", "from": 0.75, "to": 0.9}
      }
    },

    {
      "name": "settle_with_clasp",
      "duration_beats": 6,
      "blend_in_sec": 1.2,
      "blend_out_sec": 1.0,
      "pose": "hands_clasp",
      "body": {
        "yaw_rad": 0.0,
        "lean_x_rad": {"kind": "cubic-out", "from": -0.10, "to": 0.10},
        "translation": {
          "x": 0.0,
          "y": 0.0,
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 2.0,
        "leg_swing_amplitude": 0.04,
        "knee_bend": -0.16,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.45
      },
      "bones": {
        "head": {"x_rad": {"kind": "cubic-out", "from": -0.15, "to": 0.15}},
        "chest": {"x_rad": {"kind": "cubic-out", "from": -0.10, "to": 0.12}}
      },
      "morphs": {
        "smile": {"kind": "ease", "from": 0.9, "to": 0.5}
      }
    }
  ]
}
