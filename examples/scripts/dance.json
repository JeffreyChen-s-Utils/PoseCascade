{
  "schema_version": 1,
  "name": "mmd_dance_declarative_demo",
  "loop_sec": 16.0,
  "bpm": 120,

  "rig": {
    "character_root": "Sketchfab_model",
    "leg_chain_l": ["upper_leg_L", "lower_leg_L", "foot_L"],
    "leg_chain_r": ["upper_leg_R", "lower_leg_R", "foot_R"],
    "knee_limit_min": [-2.4, 0, 0],
    "knee_limit_max": [0.1, 0, 0]
  },

  "ground": {
    "kind": "flat",
    "y": 0.0
  },

  "physics_chains": {
    "hair_C":  {"stiffness": 14.0, "damping": 0.45, "inertia": 0.015},
    "hair_L":  {"stiffness": 12.0, "damping": 0.40, "inertia": 0.015},
    "hair_R":  {"stiffness": 12.0, "damping": 0.40, "inertia": 0.015},
    "hair_LL": {"stiffness":  8.5, "damping": 0.30, "inertia": 0.020},
    "hair_RR": {"stiffness":  8.5, "damping": 0.30, "inertia": 0.020},
    "orn":     {"stiffness": 22.0, "damping": 0.80, "inertia": 0.020}
  },

  "wind": {
    "direction": [1.0, 0.0, 0.3],
    "speed": 0.5,
    "turbulence_amplitude": 0.18,
    "turbulence_frequency_hz": 1.6
  },

  "phases": [
    {
      "name": "intro_bow",
      "duration_beats": 4,
      "blend_in_sec": 0.4,
      "blend_out_sec": 0.4,
      "pose": "hands_clasp",
      "body": {
        "yaw_rad": 0.0,
        "lean_x_rad": {"kind": "cubic-out", "from": 0.0, "to": 0.30},
        "translation": {
          "x": 0.0,
          "y": 0.0,
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 2.0,
        "leg_swing_amplitude": 0.05,
        "knee_bend": -0.18,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.45
      },
      "bones": {
        "head": {"x_rad": {"kind": "cubic-out", "from": 0.0, "to": 0.25}},
        "chest": {"x_rad": {"kind": "cubic-out", "from": 0.0, "to": 0.20}}
      },
      "morphs": {
        "blink": "0.5 + 0.5 * sin(elapsed * tau / 3.0)",
        "smile": {"kind": "linear", "from": 0.0, "to": 0.4}
      }
    },

    {
      "name": "wake_unfold",
      "duration_beats": 4,
      "blend_in_sec": 0.4,
      "blend_out_sec": 0.3,
      "body": {
        "yaw_rad": 0.0,
        "lean_x_rad": {"kind": "cubic-out", "from": 0.30, "to": -0.05},
        "translation": {
          "x": 0.0,
          "y": {"kind": "pulse", "from": 0.0, "to": 0.04, "center": 0.7, "width": 0.5},
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 1.0,
        "leg_swing_amplitude": 0.15,
        "knee_bend": -0.22,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.45
      },
      "bones": {
        "head": {
          "x_rad": {"kind": "cubic-out", "from": 0.25, "to": -0.10},
          "y_rad": "0.30 * sin(phase_beat * tau / 4)"
        },
        "chest": {"x_rad": {"kind": "cubic-out", "from": 0.20, "to": -0.05}},
        "upper_arm_L": {
          "x_rad": {"kind": "back-out", "from": 0.0, "to": -0.55, "overshoot": 1.8},
          "z_rad": {"kind": "quad-out", "from": 0.0, "to": 0.45}
        },
        "upper_arm_R": {
          "x_rad": {"kind": "back-out", "from": 0.0, "to": -0.55, "overshoot": 1.8},
          "z_rad": {"kind": "quad-out", "from": 0.0, "to": -0.45}
        }
      },
      "morphs": {
        "smile": 0.6
      }
    },

    {
      "name": "snap_point_R",
      "duration_beats": 4,
      "blend_in_sec": 0.2,
      "blend_out_sec": 0.2,
      "pose": "point_R",
      "body": {
        "yaw_rad": {"kind": "back-out", "from": 0.0, "to": -0.20, "overshoot": 1.5},
        "lean_x_rad": {"kind": "back-out", "from": 0.0, "to": -0.14, "overshoot": 2.5},
        "translation": {
          "x": {"kind": "back-out", "from": 0.0, "to": -0.06, "overshoot": 2.0},
          "y": 0.0,
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 1.0,
        "leg_swing_amplitude": 0.08,
        "knee_bend": -0.22,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.45
      },
      "bones": {
        "upper_leg_L": {"x_rad": {"kind": "step", "from": 0.0, "to": -0.35, "at": 0.5}}
      },
      "morphs": {
        "blink": {"kind": "step", "from": 0.0, "to": 1.0, "at": 0.5},
        "smile": 0.75
      }
    },

    {
      "name": "snap_point_L",
      "duration_beats": 4,
      "blend_in_sec": 0.2,
      "blend_out_sec": 0.3,
      "pose": "point_L",
      "body": {
        "yaw_rad": {"kind": "back-out", "from": -0.20, "to": 0.20, "overshoot": 1.5},
        "lean_x_rad": {"kind": "back-out", "from": -0.14, "to": 0.14, "overshoot": 2.5},
        "translation": {
          "x": {"kind": "back-out", "from": -0.06, "to": 0.06, "overshoot": 2.0},
          "y": 0.0,
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 1.0,
        "leg_swing_amplitude": 0.08,
        "knee_bend": -0.22,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.45
      },
      "bones": {
        "upper_leg_R": {"x_rad": {"kind": "step", "from": 0.0, "to": -0.35, "at": 0.5}}
      },
      "morphs": {
        "blink": {"kind": "step", "from": 0.0, "to": 1.0, "at": 0.5},
        "smile": 0.75
      }
    },

    {
      "name": "spin_with_trail",
      "duration_beats": 4,
      "blend_in_sec": 0.3,
      "blend_out_sec": 0.3,
      "body": {
        "yaw_rad": {"kind": "cubic-out", "from": 0.20, "to": "tau + 0.20"},
        "lean_x_rad": "0.06 * sin(phase_t * tau)",
        "translation": {
          "x": 0.0,
          "y": 0.0,
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 0.8,
        "leg_swing_amplitude": 0.15,
        "knee_bend": -0.25,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.45
      },
      "bones": {
        "upper_arm_L": {"x_rad": -0.85, "z_rad": 0.55},
        "upper_arm_R": {"x_rad": -0.85, "z_rad": -0.55},
        "head": {"y_rad": "0.50 * sin(phase_t * tau)", "x_rad": -0.10},
        "chest": {"x_rad": -0.05}
      },
      "morphs": {
        "blink": "0.5 + 0.5 * sin(elapsed * tau / 2.0)",
        "smile": 0.7
      }
    },

    {
      "name": "hip_groove",
      "duration_beats": 4,
      "blend_in_sec": 0.3,
      "blend_out_sec": 0.3,
      "pose": {"name": "hip_pop_L", "weight": "abs(sin(phase_beat * tau))"},
      "body": {
        "yaw_rad": "tau",
        "lean_x_rad": "0.10 * sin(phase_beat * tau)",
        "translation": {
          "x": "0.07 * sin(phase_beat * tau)",
          "y": "max(0.0, 0.025 * sin(phase_beat * tau * 2))",
          "z": 0.0
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 0.5,
        "leg_swing_amplitude": 0.18,
        "knee_bend": -0.32,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.20
      },
      "bones": {
        "upper_arm_L": {"x_rad": "0.45 * sin(phase_beat * tau)", "z_rad": 0.30},
        "upper_arm_R": {"x_rad": "-0.45 * sin(phase_beat * tau)", "z_rad": -0.30}
      },
      "morphs": {
        "smile": 0.85,
        "blink": "0.5 + 0.5 * sin(beat * tau / 4)"
      }
    },

    {
      "name": "introvert_pull_in",
      "duration_beats": 4,
      "blend_in_sec": 0.3,
      "blend_out_sec": 0.4,
      "pose": "arms_to_chest",
      "body": {
        "yaw_rad": "tau",
        "lean_x_rad": {"kind": "cubic-out", "from": 0.0, "to": 0.12},
        "translation": {
          "x": 0.0,
          "y": 0.0,
          "z": {"kind": "cubic-out", "from": 0.0, "to": -0.04}
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 1.5,
        "leg_swing_amplitude": 0.04,
        "knee_bend": -0.20,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.30
      },
      "bones": {
        "head": {"x_rad": {"kind": "cubic-out", "from": -0.10, "to": 0.18}},
        "chest": {"x_rad": {"kind": "cubic-out", "from": 0.0, "to": 0.15}}
      },
      "morphs": {
        "smile": {"kind": "cubic-out", "from": 0.85, "to": 0.55},
        "blink": "0.5 + 0.5 * sin(elapsed * tau / 4.0)"
      }
    },

    {
      "name": "v_arms_finale",
      "duration_beats": 4,
      "blend_in_sec": 0.4,
      "blend_out_sec": 0.4,
      "pose": "v_arms_up",
      "body": {
        "yaw_rad": "tau",
        "lean_x_rad": {"kind": "back-out", "from": 0.12, "to": -0.10, "overshoot": 1.8},
        "translation": {
          "x": 0.0,
          "y": {"kind": "pulse", "from": 0.0, "to": 0.06, "center": 0.2, "width": 0.4},
          "z": {"kind": "cubic-out", "from": -0.04, "to": 0.0}
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 0.5,
        "leg_swing_amplitude": 0.12,
        "knee_bend": -0.25,
        "arm_swing_amplitude": 0.0,
        "arm_hang_rad": -1.45
      },
      "bones": {
        "head": {
          "x_rad": -0.20,
          "y_rad": "0.15 * sin(phase_beat * tau)"
        },
        "hip": {"y_rad": "0.10 * sin(phase_beat * tau)"}
      },
      "morphs": {
        "smile": {"kind": "cubic-out", "from": 0.55, "to": 1.0}
      }
    }
  ]
}
