{
  "schema_version": 1,
  "name": "climb_stairs_demo",
  "loop_sec": 6.0,

  "rig": {
    "character_root": "Sketchfab_model",
    "leg_chain_l": ["upper_leg_L", "lower_leg_L", "foot_L"],
    "leg_chain_r": ["upper_leg_R", "lower_leg_R", "foot_R"],
    "knee_limit_min": [-2.4, 0, 0],
    "knee_limit_max": [0.1, 0, 0]
  },

  "ground": {
    "kind": "stairs",
    "base_z": -0.20,
    "step_depth": 0.04,
    "step_rise": 0.02,
    "count": 5,
    "forward_sign": -1
  },

  "physics_chains": {
    "hair_C":  {"stiffness": 14.0, "damping": 0.45, "inertia": 0.015},
    "hair_L":  {"stiffness": 12.0, "damping": 0.40, "inertia": 0.015},
    "hair_R":  {"stiffness": 12.0, "damping": 0.40, "inertia": 0.015}
  },

  "wind": {
    "direction": [1.0, 0.0, 0.0],
    "speed": 0.3,
    "turbulence_amplitude": 0.08,
    "turbulence_frequency_hz": 1.0
  },

  "phases": [
    {
      "name": "approach",
      "duration_sec": 1.0,
      "body": {
        "yaw_rad": "pi",
        "translation": {
          "x": 0,
          "y": 0,
          "z": {"kind": "linear", "from": 0.0, "to": -0.20}
        }
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 0.5,
        "leg_swing_amplitude": 0.40,
        "knee_bend": -0.25,
        "arm_swing_amplitude": 0.35
      },
      "morphs": {
        "blink": "0.5 + 0.5 * sin(elapsed * tau / 3.0)"
      }
    },

    {
      "name": "climb",
      "duration_sec": 4.0,
      "body": {
        "yaw_rad": "pi",
        "lean_x_rad": 0.10,
        "translation": {
          "stair": {
            "base_z": -0.20,
            "rise": 0.10,
            "forward": 0.20,
            "step_count": 5,
            "ascending": true,
            "rise_window": [0.40, 0.75],
            "forward_sign": -1
          }
        }
      },
      "gait": {
        "kind": "stride",
        "step_count": 5,
        "leading_lift_rad": -0.70,
        "trailing_back_rad": 0.25,
        "knee_bend_rad": 0.30,
        "arm_swing_amplitude_rad": 0.40,
        "knee_bell": [0.10, 0.65],
        "forward_bell": [0.10, 0.65],
        "lock_trailing_foot": true
      },
      "morphs": {
        "blink": "0.5 + 0.5 * sin(elapsed * tau / 3.0)",
        "effort": {"kind": "ease", "from": 0.0, "to": 0.4}
      }
    },

    {
      "name": "settle",
      "duration_sec": 1.0,
      "body": {
        "yaw_rad": "pi",
        "lean_x_rad": {"kind": "ease", "from": 0.10, "to": 0.0},
        "translation": {
          "x": 0,
          "y": 0.10,
          "z": -0.40
        }
      },
      "morphs": {
        "blink": "0.5 + 0.5 * sin(elapsed * tau / 3.0)",
        "effort": {"kind": "ease", "from": 0.4, "to": 0.0}
      }
    }
  ]
}
