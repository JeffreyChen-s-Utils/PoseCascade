{
  "schema_version": 1,
  "extends": "_herta_profile.json",
  "name": "climb_stairs_demo",
  "loop_sec": 8.0,

  "ground": {
    "kind": "stairs",
    "base_z": -0.20,
    "step_depth": 0.04,
    "step_rise": 0.02,
    "count": 5,
    "forward_sign": -1
  },

  "wind": {
    "direction": [1.0, 0.0, 0.0],
    "speed": 0.3,
    "turbulence_amplitude": 0.08,
    "turbulence_frequency_hz": 1.0
  },

  "phases": [
    {
      "name": "approach",
      "duration_sec": 2.0,
      "body": {"yaw_rad": "pi", "translation": [0, 0, [0.0, -0.20]]},
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 1.0,
        "leg_swing_amplitude": 0.50,
        "knee_bend": -0.30,
        "arm_swing_amplitude": 0.40,
        "arm_hang_rad": -0.50
      },
      "morphs": {"blink": "0.5 + 0.5 * sin(elapsed * tau / 3.0)"}
    },

    {
      "name": "climb",
      "duration_sec": 5.0,
      "body": {
        "yaw_rad": "pi",
        "lean_x_rad": 0.10,
        "translation": {
          "stair": {
            "base_z": -0.20,
            "rise": 0.10,
            "forward": 0.20,
            "step_count": 5,
            "ascending": true,
            "rise_window": [0.40, 0.75],
            "forward_sign": -1
          }
        }
      },
      "gait": {
        "kind": "stride",
        "step_count": 5,
        "leading_lift_rad": -0.40,
        "trailing_back_rad": 0.15,
        "knee_bend_rad": 0.20,
        "arm_swing_amplitude_rad": 0.30,
        "arm_hang_rad": -0.50,
        "knee_bell": [0.05, 0.75],
        "forward_bell": [0.05, 0.75],
        "lock_trailing_foot": true
      },
      "morphs": {
        "blink": "0.5 + 0.5 * sin(elapsed * tau / 3.0)",
        "effort": {"kind": "ease", "from": 0.0, "to": 0.4}
      }
    },

    {
      "name": "settle",
      "duration_sec": 1.0,
      "body": {
        "yaw_rad": "pi",
        "lean_x_rad": {"kind": "ease", "from": 0.10, "to": 0.0},
        "translation": [0, 0.10, -0.40]
      },
      "gait": {
        "kind": "walking",
        "step_cycle_sec": 1.0,
        "arm_hang_rad": -0.50
      },
      "morphs": {
        "blink": "0.5 + 0.5 * sin(elapsed * tau / 3.0)",
        "effort": {"kind": "ease", "from": 0.4, "to": 0.0}
      }
    }
  ]
}
